#!/bin/sh
# Pre-push hook: run the study-token check over every commit being pushed, not only the tip.
# A leak in any commit of a public history is permanent. Installed by `make hooks`.
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
remote="$1"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a ref pushes no commits
    if [ "$remote_sha" = "$zero" ]; then
        # New remote ref: check what the remote does not have yet.
        commits=$(git rev-list "$local_sha" --not --remotes="$remote") || status=1
    else
        commits=$(git rev-list "$remote_sha..$local_sha") || status=1
    fi
    [ -z "$commits" ] && continue
    # shellcheck disable=SC2086 # one argument per commit sha is intended
    uv run --frozen python -m expcore.provenance.study_tokens check-commits $commits || status=1
done
exit $status
