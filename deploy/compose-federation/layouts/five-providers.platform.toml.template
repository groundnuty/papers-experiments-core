# platform.toml of the five-provider example layout, rendered by federation.py into the federation's root at every up
# and reset. Each @...@ is filled from facts.json, since the ids are new at every up; every path is relative to the
# root. The study space is alpha-space, owned by aspen and mirrored by rowan, so the support set is those two.
zone = { name = "zone", url = "@zone_url@" }
providers.aspen = { url = "@provider_url.aspen@", id = "@provider_id.aspen@" }
providers.larch = { url = "@provider_url.larch@", id = "@provider_id.larch@" }
providers.rowan = { url = "@provider_url.rowan@", id = "@provider_id.rowan@" }
providers.alder = { url = "@provider_url.alder@", id = "@provider_id.alder@" }
providers.hazel = { url = "@provider_url.hazel@", id = "@provider_id.hazel@" }
space = { name = "@space_name@", id = "@space_id.alpha-space@", prefixes = ["alpha-"] }
support = { providers = ["aspen", "rowan"], local = "aspen" }
credentials.admin = { file = "secrets/admin.token" }
credentials.users = { directory = "secrets/users", pattern = "{user}.pass" }
principals.data_path = { username = "alpha-reader", user_id = "@user_id.alpha-reader@" }
principals.toolserver = { username = "alpha-tools", user_id = "@user_id.alpha-tools@" }
principals.service = { username = "alpha-health", user_id = "@user_id.alpha-health@" }
tls = { ca_file = "ca/federation-ca.pem" }
placement = { holder = "aspen" }
