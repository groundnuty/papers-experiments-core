# platform.toml of the pilot-shape-import layout, rendered by hpcfed.py up into the federation's root. Each @...@ is
# filled from facts.json (the ids are new at every up; every URL is https://<node FQDN>:8443) or by the HPC driver:
# hpc_stop_bound_s is the service's own stop bound ([hpc] stop_seconds + 90 s), hpc_step_launch_wait_s what a control
# step may wait to start ([hpc] step_launch_wait_s), hpc_command_timeout_s the floor of every relay verb's bound (that and 60 s), and
# hpc_token_margin_s is the least [tokens]
# margin_s the platform layer's own loader accepts for the rest of the file. Every path is absolute, the root's
# (hpc_root), so a copy of the file beside a study (shards.py step) reads the root's own secrets, CA and journal. The
# four data spaces give the link check ten ordered pairs. Each is held on an imported storage of a tree on the shared
# filesystem that other federations import too, so each says `import = { readonly = true, shared = true }`: the core
# refuses a shared import that is not read-only at load, checks the owner's panel for it, and
# `fedimport.verify_imports` reads this file for it, refusing a file that leaves the sharing out. The study's own space
# (alpha-work) is not declared here.
addresses = @hpc_addresses@   # O73: the address map and the resolve launcher, as one inline table that up fills; the platform layer dials each declared name at its mapped address. A top-level key, so before the first table
zone = { name = "zone", url = "@zone_url@" }
providers.aspen = { url = "@provider_url.aspen@", id = "@provider_id.aspen@" }
providers.larch = { url = "@provider_url.larch@", id = "@provider_id.larch@" }
providers.rowan = { url = "@provider_url.rowan@", id = "@provider_id.rowan@" }
providers.alder = { url = "@provider_url.alder@", id = "@provider_id.alder@" }
providers.hazel = { url = "@provider_url.hazel@", id = "@provider_id.hazel@" }
credentials.admin = { file = "@hpc_root@/secrets/admin.token" }
credentials.users = { directory = "@hpc_root@/secrets/users", pattern = "{user}.pass" }
principals.data_path = { username = "alpha-reader", user_id = "@user_id.alpha-reader@" }
principals.toolserver = { username = "alpha-tools", user_id = "@user_id.alpha-tools@" }
principals.service = { username = "alpha-health", user_id = "@user_id.alpha-health@" }
tls = { ca_file = "@hpc_root@/ca/federation-ca.pem" }   # the Onedata test CA here: each service's generated web certificate
placement = { holder = "aspen" }               # each entry's holder is its data provider; `verify_imports` needs the table
link_check = { name = "link-probes", id = "@space_id.link-probes@", prefixes = ["link-"], providers = ["aspen", "larch", "rowan", "alder", "hazel"] }

[tokens]
margin_s = @hpc_token_margin_s@

[[spaces]]
label = "alpha"
name = "alpha-space"
data_manifest = "@data_manifest.alpha-space@"   # C06: its data, checked at up
id = "@space_id.alpha-space@"
prefixes = ["alpha-"]
providers = ["larch", "aspen", "rowan"]
local = "aspen"
holder = "larch"
import = { readonly = true, shared = true }

[[spaces]]
label = "beta"
name = "beta-space"
data_manifest = "@data_manifest.beta-space@"   # C06: its data, checked at up
id = "@space_id.beta-space@"
prefixes = ["beta-"]
providers = ["rowan", "aspen"]
local = "aspen"
holder = "rowan"
import = { readonly = true, shared = true }

[[spaces]]
label = "gamma"
name = "gamma-space"
data_manifest = "@data_manifest.gamma-space@"   # C06: its data, checked at up
id = "@space_id.gamma-space@"
prefixes = ["gamma-"]
providers = ["alder", "aspen"]
local = "aspen"
holder = "alder"
import = { readonly = true, shared = true }

[[spaces]]
label = "delta"
name = "delta-space"
data_manifest = "@data_manifest.delta-space@"   # C06: its data, checked at up
id = "@space_id.delta-space@"
prefixes = ["delta-"]
providers = ["hazel", "aspen"]
local = "aspen"
holder = "hazel"
import = { readonly = true, shared = true }

[faults]                                     # the HPC backend (M4): hpcfed.py's service verbs, through the login node's relay
sanctioned = false                           # the configuration's half of the sanction: true only for a study that injects
backend = "hpc"                              # no compose_file, project, command or docker: the HPC backend refuses them
journal = "@hpc_root@/fault-journal"
stop_bound_s = @hpc_stop_bound_s@            # the service's own stop; settle_timeout_s defaults to it + the launch wait + 70
step_launch_wait_s = @hpc_step_launch_wait_s@  # a control step's wait to start: it widens timeouts only
command_timeout_s = @hpc_command_timeout_s@    # the floor of every relay verb's bound: the launch wait and 60 s

[faults.services]
aspen = "aspen"
larch = "larch"
rowan = "rowan"
alder = "alder"
hazel = "hazel"
