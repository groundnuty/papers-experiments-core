# platform.toml of the shared-import layout, rendered by up into the federation's root at every up. Each @...@ is filled
# from facts.json, since the ids are new at every up; every path is absolute, the root's (hpc_root), so a copy of the
# file beside a study (shards.py step) reads the root's own secrets and CA.
#
# Three spaces in the `[[spaces]]` form. `alpha-data` and `beta-data` are held on imported storages of trees on the
# shared filesystem that other federations import too, so each says `import = { readonly = true, shared = true }`: the
# core refuses a shared import that is not read-only at load, checks the owner's panel for it, and
# `fedimport.verify_imports` reads this file for it. `alpha-work` is the study's own space. The tables sit after every
# top-level key, since a key written after `[[spaces]]` belongs to the last entry.
zone = { name = "zone", url = "@zone_url@" }
providers.pine = { url = "@provider_url.pine@", id = "@provider_id.pine@" }
providers.birch = { url = "@provider_url.birch@", id = "@provider_id.birch@" }
providers.cedar = { url = "@provider_url.cedar@", id = "@provider_id.cedar@" }
credentials.admin = { file = "@hpc_root@/secrets/admin.token" }
credentials.users = { directory = "@hpc_root@/secrets/users", pattern = "{user}.pass" }
principals.data_path = { username = "alpha-reader", user_id = "@user_id.alpha-reader@" }
principals.toolserver = { username = "alpha-tools", user_id = "@user_id.alpha-tools@" }
principals.service = { username = "alpha-health", user_id = "@user_id.alpha-health@" }
tls = { ca_file = "@hpc_root@/ca/federation-ca.pem" }
placement = { holder = "pine" }  # each entry's holder is its data provider; a provisioner also needs the table

[[spaces]]
label = "alpha-data"
name = "alpha-data"
id = "@space_id.alpha-data@"
prefixes = ["alpha-"]
providers = ["pine", "birch", "cedar"]
local = "pine"
holder = "pine"
import = { readonly = true, shared = true }

[[spaces]]
label = "beta-data"
name = "beta-data"
id = "@space_id.beta-data@"
prefixes = ["beta-"]
providers = ["pine", "birch", "cedar"]
local = "pine"
holder = "birch"
import = { readonly = true, shared = true }

[[spaces]]
label = "alpha-work"
name = "alpha-work"
id = "@space_id.alpha-work@"
prefixes = ["alpha-"]
providers = ["pine", "birch", "cedar"]
local = "pine"
holder = "pine"
