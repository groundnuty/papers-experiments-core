# site.env.example: copy to site.env (ignored by git), fill in on the login node, then source it.
# Never commit site.env, and never paste its values into an issue, a PR or a session log.
HPC_ACCOUNT='<account>'
HPC_PARTITION='<partition>'
B='<shared_root>/hpc-federation/bundle'   # the bundle, on a filesystem the nodes see; chmod -R go-w
SH='<scratch_root>/hpcop-images'          # mkdir -m 700: the rootfs tarballs and their .provenance, nothing else
L='<scratch_root>/hpcop-logs'             # mkdir -m 700: the batch logs
