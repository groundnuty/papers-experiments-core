  "schema": [
   "CREATE TABLE attempts(\n  id INTEGER PRIMARY KEY AUTOINCREMENT, run_key TEXT NOT NULL REFERENCES runs(run_key), attempt INTEGER NOT NULL,\n  state TEXT NOT NULL,  -- running|done|infra_fail|outage_discarded|interrupted|harness_error\n  charged INTEGER NOT NULL DEFAULT 0,  -- 1: counts against the attempt limit\n  started_utc TEXT, ended_utc TEXT, wall_s REAL, pid INTEGER,\n  infra_kind TEXT, detail TEXT, termination TEXT,  -- termination: the loop's outcome name\n  input_tokens INTEGER, output_tokens INTEGER,  -- NULL: not reported\n  run_dir TEXT, cache_creation_tokens INTEGER, cache_read_tokens INTEGER, usage_complete INTEGER NOT NULL DEFAULT 1, treatment INTEGER NOT NULL DEFAULT 0, outage_kind TEXT, dispatch_seq INTEGER, lease_wait_s REAL, lease_outcome TEXT, turn_usage TEXT, topups INTEGER NOT NULL DEFAULT 0, topup_usd REAL NOT NULL DEFAULT 0, reserved_capped INTEGER, replies_checked INTEGER, deployments TEXT, admission TEXT, calls_sent INTEGER, calls_usage TEXT, spend_basis TEXT, diagnostic TEXT)",
   "CREATE INDEX attempts_run ON attempts(run_key)",
   "CREATE TABLE events(\n  id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT, kind TEXT, model TEXT, detail TEXT)",
   "CREATE TABLE meta(key TEXT PRIMARY KEY, value TEXT NOT NULL, set_utc TEXT NOT NULL)",
   "CREATE TABLE runs(\n  run_key TEXT PRIMARY KEY,  -- the canonical text of the factor values\n  digest TEXT NOT NULL UNIQUE,  -- its SHA-256\n  seq INTEGER NOT NULL,  -- place in the manifest\n  factors TEXT NOT NULL CHECK(json_valid(factors)),\n  status TEXT NOT NULL DEFAULT 'pending',  -- pending|done|infra_exhausted|harness_error\n  f_task TEXT GENERATED ALWAYS AS (json_extract(factors, '$.task')) VIRTUAL,\n  f_access TEXT GENERATED ALWAYS AS (json_extract(factors, '$.access')) VIRTUAL,\n  f_tools TEXT GENERATED ALWAYS AS (json_extract(factors, '$.tools')) VIRTUAL,\n  f_model TEXT GENERATED ALWAYS AS (json_extract(factors, '$.model')) VIRTUAL,\n  f_seed INTEGER GENERATED ALWAYS AS (json_extract(factors, '$.seed')) VIRTUAL)",
   "CREATE INDEX runs_f_access ON runs(f_access)",
   "CREATE INDEX runs_f_model ON runs(f_model)",
   "CREATE INDEX runs_f_seed ON runs(f_seed)",
   "CREATE INDEX runs_f_task ON runs(f_task)",
   "CREATE INDEX runs_f_tools ON runs(f_tools)",
   "CREATE TABLE sqlite_sequence(name,seq)"
  ]
 }
